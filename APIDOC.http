#api call for create user account
###
POST http://127.0.0.1:8000/v1/spending/register/
Content-Type: application/json

{
    "username":"react",
    "email":"react@gmail.com",
    "password":"password@123"

}

# api call for getting token
###
POST http://127.0.0.1:8000/v1/spending/token/
Content-Type: application/json

{
    "username":"django",
    "password":"password@123"
}


#api call for current user details

###
GET http://127.0.0.1:8000/v1/spending/me/
Accept: application/json
# Authorization: Basic react:password@123
Authorization: Token f7b8f7d80a1c60bfe36964f550f3073b669ff9ba


